# ==================================================================
# Nexkara Canvas — working environment for `docker compose up --build`
# ------------------------------------------------------------------
# These are safe DEV defaults (same values docker-compose already uses).
# Before deploying to production, change every value marked "CHANGE".
# ==================================================================

# --- Environment ---
# dev | production. In production the API refuses to boot with insecure defaults.
ENV=dev

# --- Postgres ---
POSTGRES_USER=nexkara
POSTGRES_PASSWORD=nexkara_dev_pw          # CHANGE for production
POSTGRES_DB=nexkara
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth / tokens ---
# CHANGE for production. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-change-me-super-secret-key
SESSION_TTL_MINUTES=60
DEVICE_TRUST_DAYS=30
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5

# --- Cookies ---
# true behind HTTPS (Caddy in prod); false for plain-http local dev.
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:3000

# --- Seed admin (first login) ---
SEED_ADMIN_EMAIL=hammad@medzah.com
SEED_ADMIN_NAME=Hammad Hasany
SEED_ADMIN_PASSWORD=admin123              # CHANGE after first login

# --- Object storage ---
# "minio" (docker-compose default) or "local" (filesystem — no MinIO needed).
STORAGE_BACKEND=minio
LOCAL_STORAGE_DIR=./storage_data

# --- MinIO ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nexkara
MINIO_SECRET_KEY=nexkara_dev_pw           # CHANGE for production
MINIO_BUCKET=prototypes
MINIO_SECURE=false
MINIO_PUBLIC_ENDPOINT=localhost:9000

# --- Uploads ---
MAX_UPLOAD_BYTES=5242880

# --- Mail (Outlook / Microsoft 365) ---
# To send real OTP email via Outlook:
#   1. MAIL_BACKEND=smtp
#   2. SMTP_USER / MAIL_FROM = the mailbox you send FROM (e.g. hammad@medzah.com)
#   3. SMTP_PASSWORD = an APP PASSWORD (create at https://account.microsoft.com
#      > Security > Advanced security > App passwords — requires 2-step
#      verification). Your normal sign-in password will NOT work.
#   4. Microsoft 365 business tenants must have SMTP AUTH enabled for the mailbox
#      (admin: Microsoft 365 admin center > Users > mailbox > Manage email apps
#      > Authenticated SMTP = on).
#   5. Restart:  docker compose up -d --build api
#   6. Verify:   docker compose exec api python -m app.mailtest you@medzah.com
#
# Host: business (@medzah.com, Microsoft 365)  -> smtp.office365.com
#       personal (@outlook.com / @hotmail.com) -> smtp-mail.outlook.com
#
# Leave MAIL_BACKEND=console to print OTP codes to `docker compose logs api`
# instead (no email setup needed).
MAIL_BACKEND=console
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Prototype sandbox (separate-origin rendering) ---
# Empty in dev (same-origin blob). In production set to an isolated host that
# serves ONLY /s/* e.g. https://sandbox.canvas.example.com
SANDBOX_ORIGIN=
SANDBOX_TOKEN_TTL_MINUTES=30

# --- Prototype card thumbnails (optional) ---
# Rendered by the headless Chromium installed in the backend image
# (`playwright install chromium`). Empty path = Playwright's default location.
CHROMIUM_PATH=

# --- Frontend ---
# Browser -> API base. In dev the Next.js rewrite proxies /api to the backend.
NEXT_PUBLIC_API_BASE=/api
# Server-side (middleware) -> API base inside the docker network.
INTERNAL_API_BASE=http://api:8000

# --- Production domains (used by Caddyfile.prod / docker-compose.prod.yml) ---
APP_DOMAIN=canvas.example.com
SANDBOX_DOMAIN=sandbox.canvas.example.com
